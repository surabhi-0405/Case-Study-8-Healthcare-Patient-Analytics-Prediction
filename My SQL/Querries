USE healthcare_analytics_dw;

-- ------------------------------------------------------------
-- 1. Patient Dimension
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS dim_patient (
    patient_id INT PRIMARY KEY,
    first_name VARCHAR(100),
    last_name VARCHAR(100),
    dob DATE,
    gender VARCHAR(20),
    contact_no BIGINT,
    address VARCHAR(255),
    chronic_conditions VARCHAR(100),
    age INT,
    has_chronic_condition TINYINT
);

-- ------------------------------------------------------------
-- 2. Doctor Dimension
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS dim_doctor (
    doctor_id INT PRIMARY KEY,
    first_name VARCHAR(100),
    last_name VARCHAR(100),
    specialization VARCHAR(100),
    contact_no BIGINT
);

-- ------------------------------------------------------------
-- 3. Admission Fact
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS fact_admission (
    admission_id INT PRIMARY KEY,
    patient_id INT,
    admission_date DATETIME,
    discharge_date DATETIME,
    diagnosis VARCHAR(100),
    doctor_id INT,
    room_no VARCHAR(50),
    length_of_stay INT,
    previous_admissions INT,

    CONSTRAINT fk_admission_patient
        FOREIGN KEY (patient_id)
        REFERENCES dim_patient(patient_id),

    CONSTRAINT fk_admission_doctor
        FOREIGN KEY (doctor_id)
        REFERENCES dim_doctor(doctor_id)
);

-- ------------------------------------------------------------
-- 4. Treatment Fact
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS fact_treatment (
    treatment_id INT PRIMARY KEY,
    admission_id INT,
    treatment_date DATETIME,
    `procedure` VARCHAR(150),
    medication VARCHAR(100),
    dosage VARCHAR(100),

    CONSTRAINT fk_treatment_admission
        FOREIGN KEY (admission_id)
        REFERENCES fact_admission(admission_id)
);

-- ------------------------------------------------------------
-- 5. Vital Signs Fact
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS fact_vital (
    vital_id INT PRIMARY KEY,
    admission_id INT,
    recorded_time DATETIME,
    heart_rate INT,
    blood_pressure VARCHAR(20),
    oxygen_level INT,
    temperature DECIMAL(5,2),
    systolic_bp INT,
    diastolic_bp INT,

    CONSTRAINT fk_vital_admission
        FOREIGN KEY (admission_id)
        REFERENCES fact_admission(admission_id)
);

-- ------------------------------------------------------------
-- 6. Admission-Level Analytics Fact
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS fact_admission_analytics (
    admission_id INT PRIMARY KEY,
    patient_id INT,
    admission_date DATETIME,
    discharge_date DATETIME,
    diagnosis VARCHAR(100),
    doctor_id INT,
    room_no VARCHAR(50),
    length_of_stay INT,
    previous_admissions INT,
    age INT,
    gender VARCHAR(20),
    chronic_conditions VARCHAR(100),
    has_chronic_condition TINYINT,

    avg_heart_rate DECIMAL(10,2),
    min_heart_rate INT,
    max_heart_rate INT,

    avg_oxygen_level DECIMAL(10,2),
    min_oxygen_level INT,

    avg_temperature DECIMAL(10,2),
    max_temperature DECIMAL(10,2),

    avg_systolic_bp DECIMAL(10,2),
    avg_diastolic_bp DECIMAL(10,2),

    vital_readings INT,
    treatment_count INT,
    procedure_count INT,
    medication_count INT,

    admission_month VARCHAR(20),
    vital_risk_flags TINYINT,
    age_group VARCHAR(20),
    risk_factor_count INT,

    risk_score INT,
    risk_level VARCHAR(20),

    CONSTRAINT fk_analytics_admission
        FOREIGN KEY (admission_id)
        REFERENCES fact_admission(admission_id)
);
