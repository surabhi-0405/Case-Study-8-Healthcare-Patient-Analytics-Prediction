    COUNT(*) AS admissions_count,
    ROUND(
        100.0 * COUNT(*) / (SELECT COUNT(*) FROM fact_admission),
        2
    ) AS admission_percentage
FROM (
    SELECT
        admission_id,
        COUNT(*) AS treatment_count
    FROM fact_treatment
    GROUP BY admission_id
) AS treatment_summary
GROUP BY treatment_count
ORDER BY treatment_count;
