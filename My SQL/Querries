SELECT
    COUNT(*) AS Total_Admissions,
    COUNT(DISTINCT patient_id) AS Unique_Patients,
    ROUND(AVG(length_of_stay), 2) AS Avg_Length_of_Stay,
    SUM(CASE WHEN risk_level = 'High' THEN 1 ELSE 0 END) AS High_Risk_Admissions,
    ROUND(
        100.0 * SUM(CASE WHEN risk_level = 'High' THEN 1 ELSE 0 END) / COUNT(*),
        2
    ) AS High_Risk_Percentage,
    SUM(CASE WHEN length_of_stay >= 7 THEN 1 ELSE 0 END) AS Long_Stay_Admissions
FROM fact_admission_analytics;
---------------------------------------------------------------------------------------
SELECT
    COUNT(*) AS total_admissions,
    COUNT(DISTINCT admission_id) AS unique_admissions,
    SUM(CASE WHEN patient_id IS NULL THEN 1 ELSE 0 END) AS missing_patient_ids,
    SUM(CASE WHEN doctor_id IS NULL THEN 1 ELSE 0 END) AS missing_doctor_ids,
    SUM(CASE WHEN risk_level IS NULL THEN 1 ELSE 0 END) AS missing_risk_levels,
    SUM(CASE WHEN risk_score IS NULL THEN 1 ELSE 0 END) AS missing_risk_scores,
    SUM(CASE WHEN length_of_stay IS NULL THEN 1 ELSE 0 END) AS missing_los
FROM fact_admission_analytics;
---------------------------------------------------------------------------------------
SELECT
    risk_factor_count,
    COUNT(*) AS admissions_count,
    ROUND(
        100.0 * COUNT(*) /
        (SELECT COUNT(*) FROM fact_admission_analytics),
        2
    ) AS admission_percentage,
    ROUND(AVG(risk_score), 2) AS avg_risk_score,
    ROUND(AVG(length_of_stay), 2) AS avg_length_of_stay,
    ROUND(AVG(treatment_count), 2) AS avg_treatments
FROM fact_admission_analytics
GROUP BY risk_factor_count
ORDER BY risk_factor_count;
---------------------------------------------------------------------------------------
SELECT
    diagnosis,
    risk_level,
    COUNT(*) AS admissions_count,
    ROUND(
        100.0 * COUNT(*) /
        SUM(COUNT(*)) OVER (PARTITION BY diagnosis),
        2
    ) AS risk_percentage,
    ROUND(AVG(length_of_stay), 2) AS avg_length_of_stay
FROM fact_admission_analytics
GROUP BY
    diagnosis,
    risk_level
ORDER BY
    diagnosis,
    CASE risk_level
        WHEN 'Low' THEN 1
        WHEN 'Medium' THEN 2
        WHEN 'High' THEN 3
    END;
---------------------------------------------------------------------------------------
SELECT
    CASE
        WHEN has_chronic_condition = 1 THEN 'Chronic Condition'
        ELSE 'No Recorded Condition'
    END AS chronic_status,
    risk_level,
    COUNT(*) AS admissions_count,
    ROUND(
        100.0 * COUNT(*) /
        SUM(COUNT(*)) OVER (PARTITION BY has_chronic_condition),
        2
    ) AS risk_percentage,
    ROUND(AVG(length_of_stay), 2) AS avg_length_of_stay
FROM fact_admission_analytics
GROUP BY
    has_chronic_condition,
    risk_level
ORDER BY
    has_chronic_condition DESC,
    CASE risk_level
        WHEN 'Low' THEN 1
        WHEN 'Medium' THEN 2
        WHEN 'High' THEN 3
    END;
