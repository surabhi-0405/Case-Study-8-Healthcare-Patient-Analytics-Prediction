    COUNT(t.treatment_id) AS total_treatments,
    COUNT(DISTINCT t.admission_id) AS admissions_count,
    ROUND(
        COUNT(t.treatment_id) / COUNT(DISTINCT t.admission_id),
        2
    ) AS avg_treatments_per_admission
FROM fact_treatment t
GROUP BY DATE_FORMAT(t.treatment_date, '%Y-%m')
ORDER BY treatment_month;
---------------------------------------------------------------------------------------
SELECT
    CASE
        WHEN a.has_chronic_condition = 1 THEN 'Chronic Condition'
        ELSE 'No Recorded Condition'
    END AS chronic_status,
    COUNT(t.treatment_id) AS total_treatments,
    COUNT(DISTINCT t.admission_id) AS admissions_count,
    ROUND(
        COUNT(t.treatment_id) / COUNT(DISTINCT t.admission_id),
        2
    ) AS avg_treatments_per_admission
FROM fact_treatment t
JOIN fact_admission_analytics a
    ON t.admission_id = a.admission_id
GROUP BY a.has_chronic_condition
ORDER BY a.has_chronic_condition DESC;
