SELECT
    COUNT(*) AS total_admissions,
    COUNT(DISTINCT a.admission_id) AS admissions_with_treatment,
    COUNT(*) - COUNT(DISTINCT a.admission_id) AS admissions_without_treatment,
    ROUND(
        100.0 * COUNT(DISTINCT a.admission_id) / COUNT(*),
        2
    ) AS treatment_coverage_percentage
FROM fact_admission a
LEFT JOIN fact_treatment t
    ON a.admission_id = t.admission_id;
